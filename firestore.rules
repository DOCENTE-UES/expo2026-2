rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Lectura p´blica para cualquier documento en /votos/{votoId}
    match /votos/{votoId} {
      allow read: if true;

      // Creaci´n s´lo si equipo es string no vac´o y puntos es entero entre 1 y 10
      allow create: if
        request.resource.data.equipo is string &&
        request.resource.data.equipo != "" &&
        request.resource.data.puntos is int &&
        request.resource.data.puntos >= 1 &&
        request.resource.data.puntos <= 10;

      // Denegar actualizaci´n y eliminaci´n
      allow update: if false;
      allow delete: if false;
    }

    // Denegar todo lo dem´s
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
